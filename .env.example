# ---- Required ----
# Token from Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# The public hostname you mapped to http://oceanic:8080 in the tunnel.
# Baked into every installer so agents know where to call home.
OCEANIC_PUBLIC_URL=https://rmm.example.com

# Dashboard login. If the password is blank, a random one is generated
# on first start and printed in `docker compose logs oceanic`.
OCEANIC_ADMIN_USER=admin
OCEANIC_ADMIN_PASSWORD=

# ---- Optional ----
# Alerts (device offline, disk >= 90%, memory >= 95%) to a Discord / Slack /
# Mattermost / ntfy webhook URL.
OCEANIC_ALERT_WEBHOOK=

# Only if you put the WHOLE hostname behind Cloudflare Access: create a service
# token and put it here; it gets embedded in installers so agents pass Access.
OCEANIC_CF_ACCESS_CLIENT_ID=
OCEANIC_CF_ACCESS_CLIENT_SECRET=

# Agent heartbeat interval and data retention.
OCEANIC_CHECKIN_SECONDS=30
OCEANIC_METRICS_RETENTION_DAYS=7
OCEANIC_JOBS_RETENTION_DAYS=90

# Image tag to run (latest, or a release such as 1.2.0).
OCEANIC_VERSION=latest
